// Style: chip-label  (Chip, label after)
// Small chip with percentage and diagonal arrow, grey label after it.
// Generated by scripts/build_styles.py from the variance-indicators skill. Do not edit
// the SVG by hand here; change the template in the script and rebuild.
//
// Measure properties: Data category = Image URL. Use in a table/matrix cell,
// the Image visual (image URL from a field), or a card visual's image slot.
// Replace [Sales MoM %] with your variance measure (see period-measures.md):
// it must return a ratio and BLANK() when the comparison is not valid.

[Sales MoM chip-label] =
VAR _Pct = [Sales MoM %]                     -- ratio, BLANK when not comparable
VAR _HigherIsBetter = TRUE ()               -- FALSE () for costs, days, defects
VAR _Decimals = 1
VAR _Label = "vs last month"            -- "" hides the label
VAR _Num = "0" & IF ( _Decimals > 0, "." & REPT ( "0", _Decimals ) ) & "%"
VAR _R = ROUND ( _Pct, _Decimals + 2 )
VAR _Dir = IF ( ISBLANK ( _Pct ), 2, SIGN ( _R ) )   -- 1 up, -1 down, 0 flat, 2 blank
VAR _Good = IF ( _HigherIsBetter, _Dir, - _Dir )
VAR _c =
    SWITCH ( TRUE (), _Dir = 2, "%2394A3B8", _Good = 1, "%2315803D", _Good = -1, "%23DC2626", "%2364748B" )
VAR _bg =
    SWITCH ( TRUE (), _Dir = 2, "%23F1F5F9", _Good = 1, "%23DCFCE7", _Good = -1, "%23FEE2E2", "%23F1F5F9" )
VAR _tc = "%2364748B"
VAR _v = IF ( _Dir = 2, "--", FORMAT ( _R, "+" & _Num & ";-" & _Num & ";" & _Num ) )
VAR _ve = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _v, "&", "&amp;" ), "<", "&lt;" ), "%", "%25" ), "#", "%23" )
VAR _le = SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _Label, "&", "&amp;" ), "<", "&lt;" ), "%", "%25" ), "#", "%23" )
VAR _HasIcon = NOT ISBLANK ( _Pct )
VAR _vw = LEN ( _v ) * 7.2
VAR _lw = LEN ( _Label ) * 6.6
VAR _iw = IF ( _HasIcon, 11, 0 )
VAR _ig = IF ( _HasIcon, 3, 0 )
VAR _lg = IF ( _Label <> "", 8, 0 )
VAR _W = ROUND ( 7+_vw+_ig+_iw+7+_lg+_lw, 0 )
VAR _Icon =
    SWITCH (
        _Dir,
        1, "<path d='M4 12L12 4M6 4H12V10' fill='none' stroke='"
           & _c
           & "' stroke-linecap='round' stroke-linejoin='round' stroke-width='2'/>",
        -1, "<g transform='translate(0,16) scale(1,-1)'><path d='M4 12L12 4M6 4H12V10' fill='none' stroke='"
            & _c
            & "' stroke-linecap='round' stroke-linejoin='round' stroke-width='2'/></g>",
        0, "<path d='M3 8H13' fill='none' stroke='"
           & _c
           & "' stroke-linecap='round' stroke-linejoin='round' stroke-width='2.5'/>",
        ""
    )
VAR _Body =
    "<rect y='2' width='"
    & ROUND ( 7+_vw+_ig+_iw+7, 0 )
    & "' height='20' rx='5' fill='"
    & _bg
    & "'/><text x='7' y='16' font-family='Segoe UI,Arial,sans-serif' font-size='12' font-weight='600' fill='"
    & _c
    & "'>"
    & _ve
    & "</text><g transform='translate("
    & ROUND ( 7+_vw+_ig, 0 )
    & ",7) scale(0.6875)'>"
    & _Icon
    & "</g><text x='"
    & ROUND ( 7+_vw+_ig+_iw+7+_lg, 0 )
    & "' y='16' font-family='Segoe UI,Arial,sans-serif' font-size='12' font-weight='400' fill='"
    & _tc
    & "'>"
    & _le
    & "</text>"
RETURN
    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _W
        & "' height='24' viewBox='0 0 " & _W & " 24'>" & _Body & "</svg>"
