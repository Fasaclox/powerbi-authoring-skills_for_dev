// Text variant of style: word-prefix  (Word prefix)
// For places that only show text: a card's reference label, callout value,
// subtitle or tooltip. Generated by scripts/build_styles.py; set-up steps are in
// references/text-variants.md.
//
// Looks like:  Up +8.2%   |   Down -4.6%   |   --
//
// [Sales MoM word-prefix Text]  -> the reference label's Value
// [Sales MoM word-prefix Color] -> Value font colour: fx > Format style: Field value

[Sales MoM word-prefix Text] =
VAR _Pct = [Sales MoM %]                     -- ratio, BLANK when not comparable
VAR _HigherIsBetter = TRUE ()               -- FALSE () for costs, days, defects
VAR _Decimals = 1
VAR _Unit = "%"                              -- "pp" when _Pct is a difference of two rates
VAR _Num = "0" & IF ( _Decimals > 0, "." & REPT ( "0", _Decimals ) )
VAR _R = ROUND ( _Pct, _Decimals + 2 )
VAR _Dir = IF ( ISBLANK ( _Pct ), 2, SIGN ( _R ) )   -- 1 up, -1 down, 0 flat, 2 blank
VAR _Label =
    SWITCH (
        _Dir,
        1, "Up",
        -1, "Down",
        0, "No change",
        ""
    )
VAR _v =
    SWITCH (
        TRUE (),
        _Dir = 2, "--",
        _Unit = "pp", FORMAT ( _R * 100, "+" & _Num & ";-" & _Num & ";" & _Num ) & " pp",
        FORMAT ( _R, "+" & _Num & "%;-" & _Num & "%;" & _Num & "%" )
    )
RETURN
    TRIM ( _Label & " " & _v )

[Sales MoM word-prefix Color] =
VAR _Pct = [Sales MoM %]                     -- ratio, BLANK when not comparable
VAR _HigherIsBetter = TRUE ()               -- FALSE () for costs, days, defects
VAR _R = ROUND ( _Pct, 3 )
VAR _Dir = IF ( ISBLANK ( _Pct ), 2, SIGN ( _R ) )   -- 1 up, -1 down, 0 flat, 2 blank
VAR _Good = IF ( _HigherIsBetter, _Dir, - _Dir )
RETURN
    SWITCH ( TRUE (), _Dir = 2, "#94A3B8", _Good = 1, "#15803D", _Good = -1, "#DC2626", "#64748B" )
