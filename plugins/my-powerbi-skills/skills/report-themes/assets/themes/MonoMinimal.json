        "categoryAxis": [
          {
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#E5E5E5"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#E5E5E5"
              }
            }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#111111"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#E5E5E5"
              }
            },
            "border": true,
            "checkboxAndApplyColor": {
              "solid": {
                "color": "#111111"
              }
            },
            "inputBoxColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI",
            "titleSize": 12
          }
