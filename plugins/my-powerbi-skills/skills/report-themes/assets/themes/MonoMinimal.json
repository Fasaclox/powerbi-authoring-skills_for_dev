        "fillCustom": [
          {
            "$id": "default",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#F5F5F5"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "referenceLabelValue": [
          {
            "$id": "default",
            "valueFontColor": {
              "solid": {
                "color": "#15803D"
              }
