        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "fontFamily": "Segoe UI",
            "labelColor": {
              "solid": {
                "color": "#555555"
              }
            },
            "showAxisTitle": false,
            "gridlineShow": false,
            "innerPadding": 20
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
