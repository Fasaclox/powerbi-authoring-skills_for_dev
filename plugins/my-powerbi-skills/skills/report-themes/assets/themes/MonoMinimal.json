        "rowHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#111111"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "subTotals": [
          {
            "backColor": {
              "solid": {
                "color": "#F5F5F5"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#111111"
              }
            }
          }
        ],
        "grandTotal": [
          {
            "backColor": {
              "solid": {
                "color": "#F5F5F5"
              }
