    "largeTitle": {
      "fontSize": 14,
      "fontFace": "Segoe UI Bold",
      "color": "#111111"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Bold",
      "color": "#111111"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#111111"
    }
