        "subTitle": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#555555"
              }
            }
          }
        ],
        "visualTooltip": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
