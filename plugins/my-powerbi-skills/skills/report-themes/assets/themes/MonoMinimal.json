            "valueFontColor": {
              "solid": {
                "color": "#111111"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 10
          }
        ],
        "visualHeader": [
          {
            "background": {
              "solid": {
                "color": "#FFFFFF"
