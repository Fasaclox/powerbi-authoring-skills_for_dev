        "title": [
          {
            "show": false
          }
        ],
        "spacing": [
          {
            "$id": "default",
            "customizeSpacing": true,
            "verticalSpacing": 2
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "tableEx": {
