            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F5F5F5"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#111111"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#111111"
              }
            },
            "fontFamily": "Segoe UI",
