            "foregroundColor": {
              "solid": {
                "color": "#111111"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#E5E5E5"
              }
            },
            "border": true,
            "inputBoxColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI"
          },
          {
            "$id": "Available",
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#111111"
              }
            },
            "borderColor": {
              "solid": {
                "color": "#E5E5E5"
              }
            },
            "border": true,
            "inputBoxColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
