            "gridHorizontalWeight": 1,
            "outlineColor": {
              "solid": {
                "color": "#E5E5E5"
              }
            },
            "rowPadding": 6
          }
        ],
        "total": [
          {
            "backColor": {
              "solid": {
                "color": "#F5F5F5"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#111111"
              }
            },
            "bold": true
